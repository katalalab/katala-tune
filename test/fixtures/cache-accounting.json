        { "path": "~/Library/Developer/Xcode/DerivedData", "gb": 5 },
        { "path": "~/Library/Developer/CoreSimulator/Devices", "gb": 10 },
        { "path": "~/.colima", "gb": 10 },
        { "path": "~/Library/Containers/com.docker.docker/Data", "gb": 10 },
        { "path": "~/other", "gb": 40 }
      ]
    },
    "cache_gib": 22,
    "cache_detail": "~/Library/Caches 12 GiB、~/.npm/_cacache 3 GiB、~/.cache 2 GiB、~/Library/Developer/Xcode/DerivedData 5 GiB",
    "storage_gib": 30,
    "storage_detail": "~/Library/Developer/CoreSimulator/Devices 10 GiB、~/.colima 10 GiB、~/Library/Containers/com.docker.docker/Data 10 GiB",
    "cleanup_commands": ["rm -rf ~/Library/Developer/Xcode/DerivedData/*", "npm cache clean --force", "brew cleanup --prune=all"]
