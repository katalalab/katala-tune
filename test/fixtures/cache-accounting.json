        { "path": "~/Library/Developer/CoreSimulator/Devices", "gb": -12 },
        { "path": "~/Library/Containers/com.docker.docker/Data" }
      ]
    },
    "cache_gib": null,
    "storage_gib": null,
    "cleanup_commands": []
  },
  {
    "name": "mixed snapshot separates cache from VM storage and unknown paths",
    "snap": {
      "probe": "mac",
      "disk": [{ "mount": "/", "total_gb": 500, "free_gb": 10, "free_pct": 2 }],
      "caches": [
        { "path": "~/Library/Caches", "gb": 12 },
        { "path": "~/Library/Caches/Homebrew", "gb": 4 },
