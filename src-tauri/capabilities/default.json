{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "画面（renderer/）が window.tune で使うコマンドと、イベントの受け取り・ウィンドウのドラッグだけを許可する。プラグインの JS API（通知・自動起動・クリップボード・外部で開く）は Rust 側からだけ使う。通知の許可の確認（読むだけ）は、通知プラグインが読み込み時に自分で呼ぶため許可する",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "notification:allow-is-permission-granted",
    "allow-config",
    "allow-last",
    "allow-probe",
    "allow-history",
    "allow-fleet",
    "allow-action",
    "allow-undo",
    "allow-actions-log",
    "allow-logs-sync",
    "allow-logs-query",
    "allow-logs-signatures",
    "allow-logs-cursors",
    "allow-copy",
    "allow-open-data-dir",
    "allow-open-config",
    "allow-status",
    "allow-set-schedule",
    "allow-set-login",
    "allow-dev-report",
    "allow-inventory",
    "allow-inventory-run",
    "allow-dogu-refresh",
    "allow-dogu-exclude",
    "allow-dogu-publish",
    "allow-ai-summary",
    "allow-ai-sessions",
    "allow-ai-sync",
    "allow-live-start",
    "allow-live-stop",
    "allow-agent-peers",
    "allow-agent-pair",
    "allow-netsec"
  ]
}
