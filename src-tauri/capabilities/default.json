{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "画面（renderer/）が window.tune で使うコマンドと、イベントの受け取り・ウィンドウのドラッグだけを許可する。プラグインの JS API（クリップボード・外部で開く）は Rust 側からだけ使う",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-config",
    "allow-last",
    "allow-probe",
    "allow-history",
    "allow-fleet",
    "allow-actions-log",
    "allow-logs-sync",
    "allow-logs-query",
    "allow-logs-signatures",
    "allow-logs-cursors",
    "allow-copy",
    "allow-open-data-dir",
    "allow-open-config",
    "allow-status",
    "allow-set-schedule",
    "allow-dev-report"
  ]
}
