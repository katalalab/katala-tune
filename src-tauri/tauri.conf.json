{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katala Tune",
  "version": "0.3.0",
  "identifier": "org.katala.tune.tauri",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Mac / Windows の機体を並列に分析し、承認した最適化だけを実行する",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png", "../build/icon.icns", "../build/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
